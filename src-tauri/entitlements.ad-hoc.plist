<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Ad-hoc signatures do not carry a Team ID, so Hardened Runtime cannot
       otherwise establish that the bundled dylib belongs to this app. A real
       Developer ID build keeps library validation enabled. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
